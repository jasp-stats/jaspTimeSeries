msgstr "ARIMAモデルをあてはめられませんでした。"

msgid "No parameters are estimated."
msgstr "推定されるパラメータがありません。"

msgid "Model Summary"
msgstr "モデルの要約"

msgid "Log-Likelihood"
msgstr "対数尤度"

msgid "AICc"
msgstr "AICc"

msgid "AIC"
msgstr "AIC"

msgid "BIC"
msgstr "BIC"

msgid "Coefficients"
msgstr "係数"

